# Overview of NON-SENSTIIVE configuration

# [App UI / Nuxt}
export CHAT_TEMPERATURE=0.3

# [Retrieval API]
export REFORMULATION_TEMPERATURE=0.1
export OPENAPI_DOCS_ENABLED=true

# [LLM Configurations]
export CHAT_MODEL=claude-sonnet-4-6
export LLM_XS_MODEL=claude-haiku-4-5
export REFORMULATION_PROVIDER=anthropic
export REFORMULATION_MODEL=claude-haiku-4-6
export EMBEDDING_MODEL=amazon.titan-embed-text-v2:0 # AWS Model
export TAGGING_MODEL=eu.amazon.nova-micro-v1:0      # AWS Model

# [RAG Pipeline]
export EMBEDDING_VECTOR_DIM=1024
export TAGGING_PROVIDER=bedrock
export RETRIEVAL_TOP_K=5
export PRIORITY_BOOST_WEIGHT=0.1
export CHUNK_MAX_CHARS=1500  # ~300-400 tokens — safe for nomic-embed-text (2048 token limit)
export CHUNK_MIN_CHARS=100   # Discard tiny fragments (e.g. heading-only sections)

# [AWS]
export AWS_PROFILE=process # credentials
export AWS_REGION=eu-west-1
export STORAGE_BACKEND=s3
export SOURCES_PREFIX=sources

# [Temporal] - Queues
export TEMPORAL_BEDROCK_QUEUE=bedrock-queue
export TEMPORAL_DB_QUEUE=db-queue
export TEMPORAL_DEFAULT_QUEUE=default

# [Temporal] - Concurrency
export TEMPORAL_TAG_CONCURRENCY=3
export TEMPORAL_EMBED_CONCURRENCY=4

# [Temporal] - Retries
export TEMPORAL_BEDROCK_MAX_ATTEMPTS=8
export TEMPORAL_DB_LOAD_MAX_ATTEMPTS=2
export TEMPORAL_LOCAL_MAX_ATTEMPTS=3 # chunk/manifest — fail fast, not unlimited
