# [App]
export NUXT_APP_ENVIRONMENT=development
export NUXT_RETRIEVAL_API_HOST=http://localhost:8000

# [Database] - Drizzle (chat sessions, designs, users)
export NUXT_DATABASE_URL=

# [Auth] - GitHub OAuth (nuxt-auth-utils) + session
export NUXT_OAUTH_GITHUB_CLIENT_ID=
export NUXT_OAUTH_GITHUB_CLIENT_SECRET=
export NUXT_SESSION_PASSWORD=   # >= 32 chars

# [Chat] - Configuration
export NUXT_AI_CHAT_TEMPERATURE=0.3
export NUXT_AI_OLLAMA_BASE_URL=http://localhost:11434   # only used when provider=ollama

# [Provider] - Options:
# - see `.env.provider.vercel`    (prod — model ids are `provider/model`)
# - see `.env.provider.anthropic` (direct — bare model ids)
# - see `.env.provider.ollama`
export NUXT_AI_PROVIDER=
export NUXT_AI_GATEWAY_API_KEY=""   # Vercel gateway key OR Anthropic key (per provider)
export NUXT_AI_CHAT_MODEL=
export NUXT_AI_LLM_XS_MODEL=
