# ----- Database -----

# Postgres/pgvector
export DATABASE_URL=

# ----- Fine-Tuning -----

# [Stage] - Chunking
export CHUNK_MAX_CHARS=1500  # ~300-400 tokens, be mindful of model limits
export CHUNK_MIN_CHARS=100   # Discard tiny fragments

# ----- Storage -----

# [S3]
export STORAGE_BACKEND=s3
export SOURCES_PREFIX=sources

# [Local Disk] ⚠️ only if NOT using S3
# export STORAGE_BACKEND=local
# export STORAGE_BASE_DIR=.

# ----- Temporal -----

# Server
export TEMPORAL_ADDRESS=localhost:7233
export TEMPORAL_NAMESPACE=default
# export TEMPORAL_API_KEY= # Temporal Cloud only
# export TEMPORAL_WORKER_BUILD_ID=  # Temporal Cloud only

# Queues
export TEMPORAL_BEDROCK_QUEUE=bedrock-queue
export TEMPORAL_DB_QUEUE=db-queue
export TEMPORAL_DEFAULT_QUEUE=default

# Concurrency
export TEMPORAL_TAG_CONCURRENCY=3
export TEMPORAL_EMBED_CONCURRENCY=4

# Retries
export TEMPORAL_BEDROCK_MAX_ATTEMPTS=8
export TEMPORAL_DB_LOAD_MAX_ATTEMPTS=2
export TEMPORAL_LOCAL_MAX_ATTEMPTS=3 # chunk/manifest — fail fast, not unlimited

# ----- LLM Providers -----

# [Provider] Model Configurations:
# - see `.env.provider.aws`
# - see `.env.provider.ollama`
# Note: Vercel and Anthropic are not suitable for RAG pipeline
export EMBEDDING_VECTOR_DIM= # depends on model
export EMBEDDING_PROVIDER=
export EMBEDDING_MODEL=
export TAGGING_PROVIDER=
export TAGGING_MODEL=
