# =============
#  AWS Bedrock
# =============
# - **Provider specific** configuration ONLY
# - see provider agnostic-config in other `.env` files

# [rag-pipeline]
export TAGGING_PROVIDER=bedrock
export TAGGING_MODEL=eu.amazon.nova-micro-v1:0

# [retrieval-api]
export REFORMULATION_PROVIDER=bedrock
export REFORMULATION_MODEL=eu.amazon.nova-micro-v1:0  # cross-region eu.* profile REQUIRED in eu-west-1

# [shared] - rag & retrieval
export EMBEDDING_PROVIDER=bedrock
export EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
export EMBEDDING_VECTOR_DIM=1024 # RDS uses 1024

# [credentials]
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_SESSION_TOKEN=""
