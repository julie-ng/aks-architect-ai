# [advisor-ui]
export NUXT_AI_PROVIDER=ollama
export NUXT_AI_CHAT_MODEL=gemma3:4b
export NUXT_AI_LLM_XS_MODEL=gemma3:270m

# [retrieval-api]
export EMBEDDING_PROVIDER=ollama
export EMBEDDING_MODEL=nomic-embed-text
