# App (Nuxt)
export AI_PROVIDER=ollama
export AI_GATEWAY_API_KEY=""
export CHAT_MODEL=gemma3:4b
export CHAT_TEMPERATURE=0.3
export LLM_XS_MODEL=gemma3:270m

# Retrieval API (FastAPI)
export REFORMULATION_PROVIDER=ollama
export REFORMULATION_MODEL=gemma3:4b
export REFORMULATION_TEMPERATURE=0.1
export OPENAPI_DOCS_ENABLED=true

# RAG Pipeline
export AWS_PROFILE=process # credentials
export AWS_REGION=eu-west-1
export EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
export EMBEDDING_VECTOR_DIM=1024
export TAGGING_MODEL=eu.amazon.nova-micro-v1:0
export TAGGING_PROVIDER=bedrock
export RETRIEVAL_TOP_K=5
export PRIORITY_BOOST_WEIGHT=0.1
export CHUNK_MAX_CHARS=1500
export CHUNK_MIN_CHARS=100

# Pipeline artifact storage (chunk/tag/embed hand-off). local = disk (dev default);
# s3 = s3://$S3_BUCKET/$PIPELINE_RUN_ID/. s3 requires both S3_BUCKET and PIPELINE_RUN_ID.
export STORAGE_BACKEND=local
export S3_BUCKET=""
export PIPELINE_RUN_ID="" # sortable UTC timestamp, e.g. 20260717T104530Z
export STORAGE_BASE_DIR=. # local backend root
export SOURCES_PREFIX=sources # set to sources-sample for fast iteration (see make pipeline/sample-sources)

# Temporal (workflows/). Address/namespace target the local CLI dev server by
# default (phase 4 → Temporal Cloud). Concurrency + retry ceilings are the tunable
# knobs; queue names split by throttled resource (bedrock vs db).
export TEMPORAL_ADDRESS=localhost:7233
export TEMPORAL_NAMESPACE=default
export TEMPORAL_BEDROCK_QUEUE=bedrock-queue
export TEMPORAL_DB_QUEUE=db-queue
export TEMPORAL_DEFAULT_QUEUE=default
# Per-stage fan-out concurrency, tuned to each model's binding Bedrock quota
# (Nova tag: 400 RPM → ~3; Titan embed: 300K TPM → ~4). Both quotas Not-adjustable.
export TEMPORAL_TAG_CONCURRENCY=3
export TEMPORAL_EMBED_CONCURRENCY=4
export TEMPORAL_BEDROCK_MAX_ATTEMPTS=8
export TEMPORAL_DB_LOAD_MAX_ATTEMPTS=2
export TEMPORAL_LOCAL_MAX_ATTEMPTS=3 # chunk/manifest — fail fast, not unlimited

# Postgres
export POSTGRES_DB=myapp
export POSTGRES_USER=myapp
export POSTGRES_PASSWORD=password
export DATABASE_URL=postgresql://myapp:password@localhost:5432/myapp

# GitHub for AuthN
export NUXT_OAUTH_GITHUB_CLIENT_ID="my-github-oauth-app-id"
export NUXT_OAUTH_GITHUB_CLIENT_SECRET="my-github-oauth-app-secret"
export NUXT_SESSION_PASSWORD="min-32-char-secret"
